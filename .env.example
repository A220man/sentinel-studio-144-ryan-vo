# Application settings
APP_NAME="Sentinel Studio"
APP_VERSION="1.0.0"
DEBUG=false

# Server
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="sqlite+aiosqlite:///./sentinel.db"

# Security
SECRET_KEY="change-me-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Keycloak OIDC
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="sentinel"
KEYCLOAK_CLIENT_ID="sentinel-studio"
KEYCLOAK_CLIENT_SECRET=""
KEYCLOAK_REDIRECT_URI="http://localhost:8000/auth/callback"

# LLM Provider (optional)
LLM_PROVIDER="openai-compatible"
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""

# Demo mode (binds to localhost only, refuses in production)
DEMO_MODE=false